# ==========================================
# JobOrbit Environment Configuration
# ==========================================

# Core Flask & Security
SECRET_KEY=joborbit-production-secret-key-2026
FLASK_ENV=production
DATABASE_URL=sqlite:///data/joborbit.db
ADMIN_TOKEN=your-private-admin-secret-token
CORS_ORIGINS=https://joborbit.live,https://www.joborbit.live,http://localhost:5173

# Scraper Settings
SCRAPER_BASE_URL=https://www.carrerlift.in
SCRAPER_DELAY=0.4
SCRAPER_TIMEOUT=12
SCRAPER_MAX_RETRIES=3
SCRAPER_INCREMENTAL_STOP_STREAK=5

# Caching & Rate Limiting
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
RATELIMIT_STORAGE_URL=memory://
RATE_LIMIT_DEFAULT=300 per hour

# Background Scheduler
SYNC_INTERVAL_HOURS=3

# Payments (Cashfree / Dodo Payments / Razorpay)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
DODO_PAYMENTS_API_KEY=your_dodo_api_key

# Authentication (Google OAuth 2.0)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Engine (Google Gemini 2.5)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
