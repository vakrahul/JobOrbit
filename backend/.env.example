# ── Core Flask App Configuration ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex
FLASK_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/joborbit
ADMIN_TOKEN=your-secure-admin-token
CORS_ORIGINS=https://joborbit.live,http://localhost:5173
APP_URL=https://api.joborbit.live

# ── Google Gemini AI LLM Configuration ────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Model Context Protocol (MCP) & OAuth 2.1 Settings ─────────────────────────
MCP_ENABLED=true
CHATGPT_CLIENT_ID=chatgpt-mcp
CHATGPT_REDIRECT_URI=https://chatgpt.com/aip/callback
OAUTH_TOKEN_EXPIRE_DAYS=30

# ── Payments (EkQR UPI / Cashfree / Razorpay) ─────────────────────────────────
EKQR_API_KEY=your-ekqr-key
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# ── Google OAuth 2.0 Client Credentials ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Rate Limiting & Caching ───────────────────────────────────────────────────
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_AUTH=10 per minute
